mapscripts CritterCave_MapScripts {
}
script CritterCave_EventScript_MasterBugCatcher{
       trainerbattle_single(TRAINER_MASTER_BUG_CATCHER,
       format("What are you doing here? This is my camp site! If you don't make a U-TURN and get out of here, I'll have to make you leave!"),
       format("Whoa, whoa! Take it easy! I'll back off. You can stay!"),
       CritterCave_EventScript_DefeatedMasterBugCatcher, NO_MUSIC)
       if (flag(FLAG_GOT_TM89) == FALSE) {
			msgbox(format("I shouldn't have been so hasty! There's plenty of room around here for both of us. Take this as an apology!"))
            checkitemspace(ITEM_TM89)
            if (var(VAR_RESULT) == FALSE) {
            	msgbox("You should make room for this.$")
                release()
                end()
            }
       }
       msgbox(format("Wow, you're pretty good! Most trainers can't keep up with my strategy. I bet you'll go far!"))
       release()
       end()
}
    
script CritterCave_EventScript_DefeatedMasterBugCatcher{
    setflag(FLAG_DEFEATED_MASTER_BUG_CATCHER)
    msgbox(format("I shouldn't have been so hasty! There's plenty of room around here for both of us. Take this as an apology!"))
    checkitemspace(ITEM_TM89)
    if (var(VAR_RESULT) == FALSE) {
    	msgbox("You should make room for this.$")
        release()
        end()
    }
    giveitem_msg(format("{PLAYER} received TM89 from the BUG CATCHER."), ITEM_TM89)
    setflag(FLAG_GOT_TM89)
    msgbox(format("TM89 contains U-TURN. It lets your POKéMON do damage, then switch out in the same turn. It's a great way to get out of a sticky situation."))
    release()
    end()
}
