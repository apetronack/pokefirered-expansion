mapscripts ShadowClawArea_MapScripts {
}
script ShadowClawArea_EventScript_MasterChanneler{
       trainerbattle_single(TRAINER_MASTER_CHANNELER,
       format("I have foreseen your arrival. Prove your worth, and you will be rewarded..."),
       format("As I had divined, your ferocity is unmatched!"),
       ShadowClawArea_EventScript_DefeatedMasterChanneler, NO_MUSIC)
       if (flag(FLAG_GOT_TM65) == FALSE) {
			msgbox(format("Here is your reward, as promised. I have foreseen that you will find it useful!"))
            checkitemspace(ITEM_TM65)
            if (var(VAR_RESULT) == FALSE) {
            	msgbox("You should make room for this.$")
                release()
                end()
            }
       }
       msgbox(format("Continue to train your POKéMON, and you will become even stronger. I have had a vision of your impending dominance over all.$"))
       release()
       end()
}

script ShadowClawArea_EventScript_DefeatedMasterChanneler{
    setflag(FLAG_DEFEATED_MASTER_CHANNELER)
    msgbox(format("Here is your reward, as promised. I have foreseen that you will find it useful!"))
    checkitemspace(ITEM_TM65)
    if (var(VAR_RESULT) == FALSE) {
    	msgbox("You should make room for this.$")
        release()
        end()
    }
    giveitem_msg(format("{PLAYER} received TM65 from the CHANNELER."), ITEM_TM65)
    setflag(FLAG_GOT_TM65)
    msgbox(format("TM65 contains SHADOW CLAW. It is a powerful Ghost-type move with a high critical hit ratio."))
    release()
    end()
}

