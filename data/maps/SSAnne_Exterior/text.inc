SSAnne_Exterior_Text_TruckNormal::
    .string "There's a large truck\n"
    .string "parked here.\p"
    .string "Nothing special\n"
    .string "about it.$"

SSAnne_Exterior_Text_TruckNeedStrength::
    .string "There's a large truck\n"
    .string "parked here.\p"
    .string "It looks like it could be moved\n"
    .string "if I had enough\n"
    .string "STRENGTH…$"

SSAnne_Exterior_Text_TruckMysteriousSound::
    .string "There's a large truck parked here.\p"
    .string "Wait… I can hear a faint,\n"
    .string "mysterious mewing sound\n"
    .string "coming from behind it…$"

SSAnne_Exterior_Text_UseStrengthOnTruck::
    .string "Maybe I can move this truck with\n"
    .string "STRENGTH to see what's behind it?$"

SSAnne_Exterior_Text_TruckRevealsSecret::
    .string "The truck moved!\p"
    .string "There was a hidden space\n"
    .string "behind it!\p"
    .string "A small, pink POKéMON\n"
    .string "emerges from the secret area!\p"
    .string "It's MEW,\n"
    .string "the mythical POKéMON!$"

SSAnne_Exterior_Text_TruckEmpty::
    .string "It's the spot where the truck\n"
    .string "used to be parked.\p"
    .string "Nothing here anymore…$"

SSAnne_Exterior_Text_ReturnSailorOffer::
    .string "Ahoy! You made it out to the\n"
    .string "old SS ANNE dock area.\p"
    .string "Ready to head back to\n"
    .string "VERMILION CITY?\n"
    .string "I can give you a ride back.$"

SSAnne_Exterior_Text_ReturnSailorAccept::
    .string "All aboard! Let's head back to\n"
    .string "the harbor.$"

SSAnne_Exterior_Text_ReturnSailorDecline::
    .string "Take your time\n"
    .string "looking around!\p"
    .string "I'll be here\n"
    .string "when you're ready.$"
