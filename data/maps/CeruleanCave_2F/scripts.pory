mapscripts CeruleanCave_2F_MapScripts {
}
script CeruleanCave_2F_EventScript_MysticGuardian{
       trainerbattle_single(TRAINER_MYSTIC_GUARDIAN,
       format("..."),
       format("Superb, it should be said."),
       CeruleanCave_2F_EventScript_DefeatedMysticGuardian, NO_MUSIC)
       if (flag(FLAG_RECEIVED_MYSTIC_TICKET) == FALSE) {
			setflag(FLAG_ENABLE_SHIP_NAVEL_ROCK)
            msgbox(format("You have demonstrated immense skill. This is your well-earned reward."))
            checkitemspace(ITEM_MYSTIC_TICKET)
            if (var(VAR_RESULT) == FALSE) {
            	msgbox("You should make room for this.$")
                release()
                end()
            }
       }
       msgbox(format("Safe travels, skilled one."))
       release()
       end()
}

script CeruleanCave_2F_EventScript_DefeatedMysticGuardian{
    setflag(FLAG_BEAT_MYSTIC_GUARDIAN)
    msgbox(format("You have demonstrated immense skill. This is your well-earned reward."))
    checkitemspace(ITEM_MYSTIC_TICKET)
    if (var(VAR_RESULT) == FALSE) {
    	msgbox("You should make room for this.$")
        release()
        end()
    }
    giveitem_msg(format("{PLAYER} received a MYSTIC TICKET from the MYSTIC GUARDIAN."), ITEM_MYSTIC_TICKET)
    setflag(FLAG_RECEIVED_MYSTIC_TICKET)
    msgbox(format("Travel to Vermilion City and present this ticket to the dockmaster. He will take you to a special place only a select few are worthy of visiting."))
    release()
    end()
}