const LOCALID_PETRO = 8

script Route23_EventScript_Petro {
	// Petro should respond to the player approaching it from the left, below, or right
	// but not from above.
	// Should do the following:
	// 1. Congratulate the player for reaching the E4
	// 2. Heal the player's party
	// 3. Battle the player
	// 4. If the player wins, give the player a big nugget
	// 5. If the player loses, encourage the player to try again
	// 6. Allow the player to rebattle Petro indefinitely so long as they talk to him again

	lock
	faceplayer
	setvar(VAR_LAST_TALKED, LOCALID_PETRO)
	msgbox(format("Hi, I'm PETRO, the creator of this hack! You have done well to make it this far. If you like, you can face me now to prepare for the challenge ahead. I will heal your party before we battle.", "1_latin_frlg"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == 1) {
		special(HealPlayerParty)
		// Use trainerbattle_no_intro for endless re-battles
		trainerbattle_no_intro(TRAINER_PETRO, format("Nicely done!", "1_latin_frlg"))
		// Check battle outcome and respond accordingly
		specialvar(VAR_RESULT, GetBattleOutcome)
		if (var(VAR_RESULT) == B_OUTCOME_WON) {
			// If the player wins, display a message, then give the player a big nugget
			msgbox(format("Impressive! You are well on your way to being prepared to take on the Pokemon League. Here, take this Big Nugget as a reward for your victory!", "1_latin_frlg"))
			giveitem(ITEM_BIG_NUGGET, 1)
		} else {
			// If the player loses, display a message and do nothing else
			msgbox(format("Keep trying! You can do it!", "1_latin_frlg"))
		}
	} else {
		msgbox(format("You know where to find me if you change your mind!", "1_latin_frlg"))
	}
	release
	end
}